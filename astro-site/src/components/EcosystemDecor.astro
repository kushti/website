/*
 * Production's ecosystem-page ambient artwork. The layers sit behind the page sections
 * (which are all `relative z-10`) and use the geometry from the live stylesheet.
 */
---

<div class="page-decor" aria-hidden="true">
  <div class="ecosystem-frame-1 hidden md:block dark:hidden"></div>
  <div class="ecosystem-frame-1 hidden dark:md:block"></div>
  <div class="ecosystem-frame-2 hidden md:block dark:hidden"></div>
  <div class="ecosystem-frame-2 hidden dark:md:block"></div>
  <div class="ecosystem-frame-3 hidden md:block dark:hidden"></div>
  <div class="ecosystem-frame-3 hidden dark:md:block"></div>
  <div class="ecosystem-blur-1 hidden md:block"></div>
  <div class="ecosystem-blur-2 hidden md:block"></div>
</div>
