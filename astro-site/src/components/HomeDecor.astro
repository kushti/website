---
/*
 * Production puts its ambient home-page artwork in absolutely positioned divs
 * between the theme script and <main>, so the frames and blurred colour fields
 * sit behind the transparent sections. Geometry comes from production's own
 * stylesheet; the assets are the light/dark files it serves.
 */
---

<div class="home-decor" aria-hidden="true">
  <div class="home-frame-3 hidden md:block dark:hidden"></div>
  <div class="home-frame-3 hidden dark:md:block"></div>
  <div class="home-frame-4 hidden md:block dark:hidden"></div>
  <div class="home-frame-4 hidden dark:md:block"></div>
  <div class="home-frame-5 hidden md:block dark:hidden"></div>
  <div class="home-frame-5 hidden dark:md:block"></div>
  <div class="home-blur-1 hidden md:block"></div>
  <div class="home-blur-2 hidden md:block"></div>
  <div class="home-blur-3 hidden md:block"></div>
  <div class="home-blur-4 hidden md:block"></div>
</div>
