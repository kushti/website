---
/*
 * Production's discover-page ambient artwork. The layers sit behind the page sections
 * (which are all `relative z-10`) and use the geometry from the live stylesheet.
 */
---

<div class="page-decor" aria-hidden="true">
  <div class="discover-frame-1 hidden md:block dark:hidden"></div>
  <div class="discover-frame-1 hidden dark:md:block"></div>
  <div class="discover-frame-2 hidden md:block dark:hidden"></div>
  <div class="discover-frame-2 hidden dark:md:block"></div>
  <div class="discover-frame-3 hidden md:block dark:hidden"></div>
  <div class="discover-frame-3 hidden dark:md:block"></div>
  <div class="discover-blur-1 hidden md:block"></div>
  <div class="discover-blur-2 hidden md:block"></div>
</div>
