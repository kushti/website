---
/**
 * AUTOLYKOS / The Future of Proof of Work — production's tinted panel, split two thirds
 * to one third: the 80px heading and the mining CTA on the left, the explanation on the
 * right, inside a `card-bg` panel inset 16px from the 1300px measure.
 */
import PillButton from '../PillButton.astro';
import { normaliseLocale } from '../../i18n/config';
import { t } from '../../i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const loc = normaliseLocale(locale);

/**
 * The recovered CMS string starts with a stray "b": production's `<b>Autolykos</b>` was
 * flattened with the tag name. The word is rendered as bold text here and the rest of the
 * sentence starts after that leading "b".
 */
const autolykosText = t(loc, 'components.autolykos.text').replace(/^b/, '');
---

<section id="Autolykos" class="relative z-10 mx-auto max-w-[1300px] scroll-mt-24">
  {/* mobile */}
  <div class="card-bg mx-4 rounded-xl px-4 py-12 md:hidden">
    <p class="text-sm"><b>{t(loc, 'components.autolykos.header')}</b></p>
    <h2 class="display-80 mt-4 leading-none">
      {t(loc, 'components.autolykos.title')}
    </h2>
    <p class="mt-8"><b>Autolykos</b>{autolykosText}</p>
    <div class="my-8">
      <PillButton href={`/${loc}/get-erg/#Mining`} class="px-6 py-3 text-lg">
        {t(loc, 'components.autolykos.button')}
      </PillButton>
    </div>
  </div>

  {/* desktop */}
  <div class="card-bg mx-4 hidden rounded-xl px-14 py-12 md:block">
    <p class="font-display text-xl leading-[1.5]"><b>{t(loc, 'components.autolykos.header')}</b></p>
    <div class="flex flex-row">
      <div class="w-2/3">
        <p class="display-80 mt-6 leading-none">
          {t(loc, 'components.autolykos.title')}
        </p>
        <div class="float-right my-8 pr-28">
          <PillButton href={`/${loc}/get-erg/#Mining`} class="px-6 py-3 text-lg">
            {t(loc, 'components.autolykos.button')}
          </PillButton>
        </div>
      </div>
      <div class="w-1/3">
        <p class="mt-8 text-2xl"><b>Autolykos</b>{autolykosText}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* production's tinted card ground */
  .card-bg {
    background-color: rgb(255 255 255 / 0.6);
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.4);
  }

  :global(.dark) .card-bg {
    background:
      linear-gradient(240.01deg, rgb(255 255 255 / 0.15) -4.45%, rgb(255 255 255 / 0) 17.42%),
      linear-gradient(246.95deg, rgb(255 255 255 / 0) 65.9%, rgb(255 255 255 / 0.15)),
      rgb(18 18 18 / 0.4);
  }
</style>
