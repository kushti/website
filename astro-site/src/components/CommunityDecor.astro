---
/*
 * Production's community-page ambient artwork. Same pattern as EcosystemDecor: absolute
 * layers behind the page, with the geometry taken from the live stylesheet at desktop
 * width. The media query in global.css hides all decor below 1280px.
 */
---

<div class="page-decor page-decor--clip" aria-hidden="true">
  <div class="community-blur-1 hidden md:block dark:hidden"></div>
  <div class="community-blur-1 hidden dark:md:block"></div>
  <div class="community-blur-2 hidden md:block dark:hidden"></div>
  <div class="community-blur-2 hidden dark:md:block"></div>
  <div class="community-frame-1 hidden md:block dark:hidden"></div>
  <div class="community-frame-1 hidden dark:md:block"></div>
  <div class="community-frame-2 hidden md:block dark:hidden"></div>
  <div class="community-frame-2 hidden dark:md:block"></div>
  <div class="community-frame-3 hidden md:block dark:hidden"></div>
  <div class="community-frame-3 hidden dark:md:block"></div>
  <div class="community-frame-4 hidden md:block dark:hidden"></div>
  <div class="community-frame-4 hidden dark:md:block"></div>
  <div class="community-frame-5 hidden md:block dark:hidden"></div>
  <div class="community-frame-5 hidden dark:md:block"></div>
  <div class="community-frame-6 hidden md:block dark:hidden"></div>
  <div class="community-frame-6 hidden dark:md:block"></div>
  <div class="community-frame-7 hidden md:block dark:hidden"></div>
  <div class="community-frame-7 hidden dark:md:block"></div>
  <div class="community-frame-8 hidden md:block dark:hidden"></div>
  <div class="community-frame-8 hidden dark:md:block"></div>
  <div class="community-frame-9 hidden md:block dark:hidden"></div>
  <div class="community-frame-9 hidden dark:md:block"></div>
  <div class="community-frame-10 hidden md:block dark:hidden"></div>
  <div class="community-frame-10 hidden dark:md:block"></div>
</div>
