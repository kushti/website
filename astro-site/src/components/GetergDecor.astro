---
/*
 * Production's get-erg ambient artwork. The layers sit behind the page sections
 * (which are all `relative z-10`) and use the geometry from the live stylesheet.
 */
---

<div class="page-decor" aria-hidden="true">
  <div class="geterg-frame-1 hidden md:block dark:hidden"></div>
  <div class="geterg-frame-1 hidden dark:md:block"></div>
  <div class="geterg-frame-2 hidden md:block dark:hidden"></div>
  <div class="geterg-frame-2 hidden dark:md:block"></div>
  <div class="geterg-frame-3 hidden md:block dark:hidden"></div>
  <div class="geterg-frame-3 hidden dark:md:block"></div>
  <div class="geterg-frame-4 hidden md:block dark:hidden"></div>
  <div class="geterg-frame-4 hidden dark:md:block"></div>
  <div class="geterg-frame-5 hidden md:block dark:hidden"></div>
  <div class="geterg-frame-5 hidden dark:md:block"></div>
  <div class="geterg-blur-1 hidden md:block"></div>
  <div class="geterg-blur-2 hidden md:block"></div>
  <div class="geterg-blur-3 hidden md:block"></div>
</div>
