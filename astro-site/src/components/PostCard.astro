---
import { t } from '../i18n';
import { mediaSrc, mediaSrcset, type Post } from '../lib/content';
import { normaliseLocale } from '../i18n/config';
import { formatLongDate } from '../lib/dates';

interface Props {
  post: Post;
  /** "compact" is used inside the index list, "feature" on the home page */
  variant?: 'compact' | 'feature';
  /** category pages print the CMS date in UTC, unlike the blog and community feeds */
  utcDate?: boolean;
}

const { post, variant = 'compact', utcDate = false } = Astro.props;
const loc = normaliseLocale(post.data.locale);
const href = post.data.externalUrl ?? `/${loc}/blog/${encodeURI(post.data.slug)}/`;
const isExternal = Boolean(post.data.externalUrl);

const date = post.data.date
  ? formatLongDate(loc, post.data.date, utcDate ? 'UTC' : undefined)
  : '';

const body = post.body ?? '';
const minutes = Math.max(1, Math.round(body.split(/\s+/).length / 220));

/**
 * The card heading is the post title.
 *
 * It was previously `subtitle || title`, which put a long excerpt in the heading slot
 * on every post that has one — 118 of them render the first line of the body as a
 * headline. `subtitle` is used below the title as an excerpt, which is what the live
 * site does with it.
 */
const title = post.data.title;

/**
 * Most posts have a subtitle, which production uses as the card excerpt. News entries
 * often have none and production shows the opening of the body instead; strip the
 * markdown so the three-line clamp reads like the live card.
 */
const plainBody = body
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#*_>`]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const excerpt = post.data.subtitle ?? (plainBody ? plainBody.slice(0, 240) : '');

const img = post.data.image;
const src = mediaSrc(img, variant === 'feature' ? 1000 : 640);
const srcset = mediaSrcset(img);
const tag = post.data.tags[0];
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl border bg-white dark:bg-white/5',
    variant === 'feature'
      ? 'h-[520px] max-w-[384px] border-transparent shadow-xl transition-transform duration-200 hover:-translate-y-1 hover:shadow-2xl'
      : 'h-full border-[var(--border)] transition-shadow hover:shadow-lg',
  ]}
>
  {/*
    Production sizes the artwork area to a fixed height rather than to a ratio, so a portrait
    post and a landscape post both get the same box and the image is cropped to fit. That is
    what `object-cover` over a fixed height does here; a fixed aspect ratio would letterbox
    the tall images instead. The home carousel uses 192px, the blog index 176-192px.
  */}
  {
    src && (
      <div
        class:list={[
          'relative w-full overflow-hidden bg-[var(--surface)]',
          variant === 'feature' ? 'h-[192px]' : 'h-44 sm:h-48',
        ]}
      >
        <a href={href} tabindex="-1" aria-hidden="true">
          <img
            src={src}
            srcset={srcset}
            width={img?.width}
            height={img?.height}
            alt=""
            loading="lazy"
            decoding="async"
            class="card-hex h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
        </a>
        {tag && (
          <a
            href={`/${loc}/category/${encodeURIComponent(tag)}/`}
            class:list={[
              'absolute top-4 right-4 z-20 inline-flex w-fit items-center rounded-full border border-brand-orange-dark bg-brand-orange font-semibold tracking-widest text-black uppercase',
              variant === 'feature'
                ? 'px-3.5 py-1.5 text-xs md:text-sm'
                : 'px-3 py-1 text-xs',
            ]}
          >
            {tag}
          </a>
        )}
      </div>
    )
  }

  <div
    class:list={[
      'flex flex-1 flex-col rounded-b-2xl',
      variant === 'feature' ? 'justify-start overflow-hidden p-4 md:p-6' : 'p-5',
    ]}
  >
    {/*
      Production sets the card title in Roboto 20px at weight 600, not in the display face —
      measured with scripts/measure-text.mjs. The long titles wrap to three lines there, so
      the card body is allowed to grow rather than clamping.
    */}
    <h3
      class:list={[
        'text-xl leading-snug font-semibold',
        variant === 'feature' ? 'mb-2 line-clamp-2' : '',
      ]}
    >
      <a href={href} class="after:absolute after:inset-0 hover:text-brand-orange">{title}</a>
    </h3>

    {excerpt && (
      <p
        class:list={[
          'text-[var(--fg-muted)]',
          variant === 'feature'
            ? 'mb-2 line-clamp-3 text-base leading-snug'
            : 'mt-2 line-clamp-3',
        ]}
      >
        {excerpt}
      </p>
    )}

    {/*
      Production's byline puts the author and date on one line, the reading time and the
      News badge on the other, with the two lines separated rather than interleaved — which
      is why a long author name truncates on this build but not there. The home carousel
      card omits the reading time entirely.
    */}
    <div
      class:list={[
        'mt-auto flex flex-wrap items-center gap-x-3 gap-y-1',
        variant === 'feature' ? 'pt-2 text-base' : 'pt-4 text-sm',
      ]}
    >
      <span class="flex min-w-0 items-center gap-2">
        <img
          src="/images/ergo-mark.svg"
          alt=""
          width="82"
          height="82"
          class:list={[
            'shrink-0 dark:invert',
            variant === 'feature' ? 'h-10 w-10' : 'h-7 w-7',
          ]}
        />
        <span class:list={[variant === 'feature' ? 'ml-1' : '', 'min-w-0']}>
          <b class="block max-w-[140px] truncate text-base text-black dark:text-white">
            {post.data.author}
          </b>
          {date && (
            <time
              datetime={post.data.date?.toISOString()}
              class="block max-w-[160px] truncate whitespace-nowrap text-black dark:text-white"
            >
              {date}
            </time>
          )}
        </span>
      </span>

      {
        variant !== 'feature' && (
          <span class="ml-auto flex items-center gap-3">
            <span class="shrink-0 text-xs">
              {minutes} {t(loc, 'blog.post.readTime')}
            </span>
            {post.data.type === 'news' && (
              <span class="shrink-0 rounded-full bg-brand-orange px-2 py-0.5 text-xs font-bold text-white">
                News
              </span>
            )}
          </span>
        )
      }
    </div>
  </div>

  {
    !src && (
      <div class="absolute top-3 right-3">
        {tag && (
          <a
            href={`/${loc}/category/${encodeURIComponent(tag)}/`}
            class="rounded-full bg-brand-orange px-3 py-1 text-xs font-bold tracking-wider text-white uppercase"
          >
            {tag}
          </a>
        )}
      </div>
    )
  }

  {/* production marks news posts on the card itself, bottom right */}
  {variant === 'feature' && post.data.type === 'news' && (
    <span class="absolute right-3 bottom-3 z-20 rounded-full bg-brand-orange px-3 py-1 text-xs font-semibold text-black shadow-md">
      📣 News
    </span>
  )}
</article>
