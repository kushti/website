---
import { categoryCounts, categories, type Post } from '../lib/content';
import { normaliseLocale, type Locale } from '../i18n/config';
import { t } from '../i18n';
import { PER_PAGE } from '../i18n/routes';
import PostCard from './PostCard.astro';

interface Props {
  locale: string;
  posts: Post[];
  /** the page heading; the blog index says "Posts", a category page its name */
  title: string;
  /** 1-based page number; omit for the first page */
  page?: number;
  perPage?: number;
}

const { locale, posts, title, page, perPage = PER_PAGE } = Astro.props;
const loc: Locale = normaliseLocale(locale);

const counts = await categoryCounts(loc);
const cats = await categories(loc);

const current = page ?? 1;
const start = (current - 1) * perPage;
const slice = page ? posts.slice(start, start + perPage) : posts;

const newsCount = posts.filter((p) => p.data.type === 'news').length;
const blogCount = posts.length - newsCount;

---

{/*
  Production's blog index is not a gradient hero: a filter row (orange Categories
  disclosure, All/News/Blogs selector) and the 140px "Posts" heading share one line at the
  top of the 1300px measure, then the 3-up card grid runs underneath. Cards are capped at
  384px inside 423px columns, with an 80px row gap.
*/}
<div id="Blog" class="relative z-10 mx-auto w-full max-w-[1300px] p-4">
  <div class="mx-6 mb-10">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div class="flex flex-col gap-3 sm:flex-row md:flex-wrap">
        <details class="group relative z-20">
          <summary
            class="inline-flex cursor-pointer list-none items-center gap-2 rounded-full border border-brand-orange-dark bg-brand-orange px-4 py-2 text-white uppercase shadow-lg shadow-brand-orange/25 transition-transform duration-200 hover:scale-[1.02] active:scale-[0.98] [&::-webkit-details-marker]:hidden"
          >
            <span class="text-xs font-semibold tracking-widest">
              {t(loc, 'blog.filter.categories')}
            </span>
            <svg
              class="h-4 w-4 transition-transform group-open:rotate-180"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
                clip-rule="evenodd"></path>
            </svg>
          </summary>

          <div
            class="absolute top-full left-0 mt-2 max-h-[360px] w-[420px] overflow-y-auto rounded-2xl border border-[var(--border)] bg-white p-2 shadow-xl dark:bg-[#1b1b1b]"
          >
            <a
              href={`/${loc}/blog/`}
              class="block rounded-lg px-3 py-2 text-sm font-semibold hover:bg-brand-orange/10 hover:text-brand-orange"
            >
              {t(loc, 'blog.filter.all')} ({posts.length})
            </a>
            {
              cats.map((c) => (
                <a
                  href={`/${loc}/category/${encodeURIComponent(c)}/`}
                  class="block rounded-lg px-3 py-2 text-sm hover:bg-brand-orange/10 hover:text-brand-orange"
                >
                  {c} ({counts[c]})
                </a>
              ))
            }
          </div>
        </details>

        <div>
          <label class="sr-only" for="post-type-filter">Filter posts</label>
          <select
            id="post-type-filter"
            aria-label="Filter posts"
            class="min-w-[220px] rounded-full border border-black/10 bg-white/85 px-4 py-2 text-sm font-semibold text-gray-950 shadow-md backdrop-blur-md focus:ring-2 focus:ring-brand-orange focus:outline-none dark:border-white/20 dark:bg-black/70 dark:text-white"
          >
            <option value="all">{t(loc, 'blog.filter.all')} ({posts.length})</option>
            <option value="news">{t(loc, 'components.news.title')} ({newsCount})</option>
            <option value="blog">{t(loc, 'components.news.blog')} ({blogCount})</option>
          </select>
        </div>
      </div>

      <h1
        class="display-140 inline-block self-start rounded-md bg-white/70 px-2.5 py-1 shadow-sm md:self-end md:bg-transparent md:px-0 md:py-0 md:shadow-none dark:bg-black/40 md:dark:bg-transparent"
        style="line-height: 1.16;"
      >
        {title}
      </h1>
    </div>
  </div>

  <div class="mt-10">
    <div class="grid w-full grid-cols-1 gap-y-10 md:grid-cols-2 md:gap-y-20 xl:grid-cols-3">
      {
        slice.map((post) => (
          <div class="w-full" data-post-type={post.data.type}>
            <PostCard post={post} variant="feature" />
          </div>
        ))
      }
    </div>
  </div>

</div>

<script>
  /** the live selector filters the cards in place */
  const select = document.getElementById('post-type-filter') as HTMLSelectElement | null;
  select?.addEventListener('change', () => {
    const type = select.value;
    document.querySelectorAll<HTMLElement>('[data-post-type]').forEach((card) => {
      card.hidden = type !== 'all' && card.dataset.postType !== type;
    });
  });
</script>
